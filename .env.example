APP_NAME=33HomeStay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database ---
# Default: SQLite (tidak perlu instal apa pun). File: database/database.sqlite
DB_CONNECTION=sqlite
# Untuk MySQL/MariaDB, ganti menjadi:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=homestay33
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

# --- Profil & aturan 33HomeStay (SESUAIKAN) ---
HOMESTAY_NAME=33HomeStay
# Nomor WhatsApp Business pengelola, format internasional tanpa tanda + (contoh: 6281234567890)
HOMESTAY_WHATSAPP=6283851517910
HOMESTAY_INSTAGRAM=villadianyer
HOMESTAY_TIKTOK=villadianyer
HOMESTAY_ADDRESS="Bandulu, Kec. Anyar, Kabupaten Serang, Banten 42166 (Jl. Raya Karang Bolong No. Km. 132)"
HOMESTAY_MAPS_URL=https://maps.app.goo.gl/Wu2vjW9pdAofcYmH7?g_st=ac
# Usulan tim - KONFIRMASI ke Owner sebelum dipakai operasional:
HOMESTAY_DP_PERCENTAGE=50
HOMESTAY_DP_DEADLINE_HOURS=6
HOMESTAY_CHECKIN_CUTOFF=22:00
HOMESTAY_DP_FORFEIT_ON_NO_SHOW=true

# --- Chatbot AI (opsional) ---
# Tanpa API key, chatbot tetap jalan dengan mode dasar (berbasis aturan).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
